# Generated by liftoff. Source: fixture-context_shared.
resource "spacelift_context" "shared" {
  name         = "Shared"
  space_id     = local.space_id
  description  = "Shared credentials"
  before_init  = ["export CA_BUNDLE=\"$(cat /mnt/workspace/liftoff/ctx-1/CA_BUNDLE)\""]
  before_apply = ["export CA_BUNDLE=\"$(cat /mnt/workspace/liftoff/ctx-1/CA_BUNDLE)\""]
}

# sensitive: SHARED_TOKEN — set via liftoff finalize sensitive
# sensitive: liftoff/ctx-1/CLIENT_KEY — set via liftoff finalize sensitive

resource "spacelift_environment_variable" "endpoint" {
  context_id = spacelift_context.shared.id
  name       = "ENDPOINT"
  value      = "https://api.example.com"
  write_only = false
}

resource "spacelift_mounted_file" "liftoff-ctx-1-ca-bundle" {
  context_id    = spacelift_context.shared.id
  relative_path = "liftoff/ctx-1/CA_BUNDLE"
  content       = "LS0tY2VydC0tLQ=="
  write_only    = false
}
