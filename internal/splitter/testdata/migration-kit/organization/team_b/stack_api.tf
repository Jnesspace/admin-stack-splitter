# Generated by liftoff. Source: fixture-stack_api.
resource "spacelift_stack" "api" {
  name                    = "api-service"
  space_id                = local.space_id
  repository              = "services"
  branch                  = "release"
  project_root            = "api"
  autodeploy              = true
  description             = "Primary API $${var.unexpanded}"
  labels                  = ["team:platform", "env:prod"]
  terraform_version       = "1.7.0"
  terraform_workflow_tool = "OPEN_TOFU"
  before_init             = ["tofu fmt -check"]
  after_apply             = ["echo done", "notify"]

  gitlab {
    id        = "gitlab-main"
    namespace = "example-org"
  }
}

# sensitive: API_TOKEN — set via liftoff finalize sensitive
# sensitive: secrets/key.pem — set via liftoff finalize sensitive

resource "spacelift_environment_variable" "dup" {
  stack_id   = spacelift_stack.api.id
  name       = "Dup"
  value      = "upper"
  write_only = false
}

resource "spacelift_environment_variable" "log_level" {
  stack_id   = spacelift_stack.api.id
  name       = "LOG_LEVEL"
  value      = "debug"
  write_only = false
}

resource "spacelift_environment_variable" "tf_var_region" {
  stack_id   = spacelift_stack.api.id
  name       = "TF_VAR_region"
  value      = "us-east-1"
  write_only = false
}

resource "spacelift_environment_variable" "dup_var-dup-lower" {
  stack_id   = spacelift_stack.api.id
  name       = "dup"
  value      = "lower"
  write_only = false
}

resource "spacelift_mounted_file" "config-app-json" {
  stack_id      = spacelift_stack.api.id
  relative_path = "config/app.json"
  content       = "eyJrIjoidiJ9"
  write_only    = false
}

resource "spacelift_context_attachment" "global_api" {
  context_id = var.inherited_contexts["global"]
  stack_id   = spacelift_stack.api.id
  priority   = 1
}

resource "spacelift_context_attachment" "shared_api" {
  context_id = var.inherited_contexts["shared"]
  stack_id   = spacelift_stack.api.id
  priority   = 0
}
